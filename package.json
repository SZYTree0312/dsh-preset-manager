{
  "name": "dsh-preset-manager",
  "version": "0.1.8",
  "description": "DeepSeek Harness plugin: switch a running conversation's agent preset from a session-header menu or a slash command, with a cache-preserving soft mode. | DSH 插件：在会话头部菜单或斜杠命令里切换 preset，并提供保留 prompt 与前缀缓存的柔切。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "agent-preset",
    "preset",
    "preset-switch"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    "./client": "./client.js",
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node test/plugin.test.mjs"
  }
}
