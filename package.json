{
  "name": "dsh-preset-manager",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: list the profile's agent presets and switch a running conversation to another one. | DSH 插件：列出 profile 的 Agent preset，并在对话内切换当前会话的 preset。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "agent-preset",
    "preset",
    "preset-switch"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "scripts": {
    "check": "node --check index.js",
    "test": "node test/plugin.test.mjs"
  }
}